{
  "name": "codex-desktop-reverse-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve-atlas.mjs",
    "build": "node scripts/build-atlas.mjs",
    "research": "node scripts/build-research-model.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
