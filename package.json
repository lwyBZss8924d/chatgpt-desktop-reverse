    "@fontsource/noto-sans-sc": "5.3.0",
    "@xyflow/react": "12.11.6",
    "elkjs": "^0.11.0",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "playwright-core": "^1.61.1",
    "prettier": "^3.8.1",
    "shiki": "^4.4.2",
    "typescript": "^6.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": "24.x"
